  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Karasheka</name>
  <summary>Retro karate in the apartment</summary>
  <developer id="io.github.amirgeva">
    <name>Amir Geva</name>
  </developer>
  <description>
    <p>
      Karasheka is a retro karate game in which two karateka fight it out in
      an apartment. Jump onto the furniture to get out of the way, then dive
      kick down on your opponent; light furniture breaks under a heavy landing.
    </p>
    <ul>
      <li>One player against the computer at three levels, or two players on one keyboard</li>
      <li>High, mid and low attacks, each blocked only by the guard at its height</li>
      <li>Four rooms with furniture to climb on and break</li>
      <li>A watch mode where two computers fight</li>
      <li>All graphics and sound are generated by the game itself</li>
    </ul>
  </description>
  <launchable type="desktop-id">karasheka.desktop</launchable>
  <url type="homepage">https://github.com/amirgeva/karasheka</url>
  <url type="bugtracker">https://github.com/amirgeva/karasheka/issues</url>
